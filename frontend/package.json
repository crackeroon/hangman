{
  "name": "hangman-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "serve": "node node_modules/vite/bin/vite.js  --port 8081",
    "preview": "node node_modules/vite/bin/vite.js build --watch --mode preview & node node_modules/vite/bin/vite.js preview --mode preview --host",
    "build": "node node_modules/vite/bin/vite.js build --out-dir dist",
    "ts": "vue-tsc",
    "lint": "eslint src",
    "tsc-full": "vue-tsc --noEmit --skipLibCheck",
    "lint-prod": "NODE_ENV=production eslint src",
    "lint:fix": "eslint src --fix",
    "dev": "vite --host --port 8081"
  },
  "engines": {
    "node": ">=25.7.0"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "typescript": "^6.0.3",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "sass": "^1.100.0",
    "vite": "^8.0.16"
  }
}
